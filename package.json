{
  "name": "react-ts",
  "version": "0.1.0",
  "description": "React TypeScript Webpack setup for 2025",
  "main": "main/index.js",
  "productName": "React App",
  "scripts": {
    "build:web": "webpack --config ./webpack.config.prod.js",
    "build:electron": "electron-builder",
    "build-deploy": "npm run build && npm run images && ./deploy.sh",
    "deploy": "./deploy.sh",
    "dev": "webpack s",
    "eapp": "concurrently -k \"BROWSER=none npm start\" \"npm:electron\"",
    "electron:dev": "wait-on tcp:7000 && electron .",
    "electron:pack": "electron-builder --dir",
    "images": "cp src/assets/images/favicon.ico dist/favicon.ico && cp src/assets/images/social-media.png dist/social-media.png",
    "serve": "./node_modules/.bin/webpack serve",
    "start": "webpack s --config ./webpack.config.dev.js",
    "test": "jest"
  },
  "keywords": [
    "react",
    "webpack"
  ],
  "author": "Chris Hammock",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.2",
    "qs": "^6.14.0",
    "ramda": "^0.32.0",
    "ramjam": "^1.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "socket.io-client": "^4.8.1",
    "use-ls": "^0.0.6",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/ramda": "^0.31.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "concurrently": "^9.2.1",
    "css-loader": "^7.1.2",
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12",
    "electron-is-dev": "^3.0.1",
    "html-webpack-plugin": "^5.6.5",
    "jest": "^30.2.0",
    "jest-css-modules": "^2.1.0",
    "jest-environment-jsdom": "^30.2.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "wait-on": "^9.0.3",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2",
    "webpack-merge": "^6.0.1"
  },
  "build": {
    "appId": "com.ptelex.react-ts",
    "productName": "React App",
    "files": [
      "dist/**/*",
      "main/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist/electron"
    }
  }
}
